# ============ 数据库配置 ============
# PostgreSQL 连接串，格式：postgresql://用户名:密码@主机:端口/数据库名
# Supabase 示例：postgresql://postgres:[密码]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ngpvgztfskyhytxwfeje.supabase.co:5432/postgres

# ============ DeepSeek 配置（用于内容生成，必填） ============
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============ Embedding 配置（用于 RAG 向量检索，选填） ============
# DeepSeek 暂不提供 embedding 接口，这里用硅基流动 SiliconFlow（国内免费、直连）。
# 注册地址：https://cloud.siliconflow.cn/  （注册送免费额度）
# 若不配置，将跳过向量存储与 RAG 搜索，但内容生成功能不受影响。
# 也可替换为 OpenAI 官方或其他 OpenAI 兼容服务（需同步改 EMBEDDING_MODEL 和 EMBEDDING_DIMENSION）。
OPENAI_API_KEY=sk-你的硅基流动Key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 向量维度：bge-large-zh-v1.5=1024，OpenAI text-embedding-3-small=1536
EMBEDDING_DIMENSION=1024
